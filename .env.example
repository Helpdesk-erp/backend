# Copie este archivo como .env en la carpeta Backend y complete los valores.
# El archivo .env no se sube al repositorio. Los valores van sin comillas.

# Clave para firmar los tokens JWT. Mínimo 32 caracteres. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Cadena de conexión de MongoDB, sin comillas. En Atlas es la MONGODB_URI de
# base_datos/atlas-credentials.env (allá viene entre comillas; aquí se pegan sin ellas).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/

# Opcionales
# MONGODB_DATABASE=helpdesk_erp
# CORS_ORIGENES=http://localhost:5173
